DATABASE_URL=postgresql://arb:arb@localhost:5432/arb
ASSETS=btc,eth,sol,xrp

# --- Paper trading ---
PAPER_SIZE=10
MIN_EDGE_BPS=20
POLL_INTERVAL_S=2
MAX_STALE_S=2
MAX_SKEW_S=1.5
NO_ENTRY_FIRST_S=5
NO_ENTRY_LAST_S=60

# --- Risque (voir README) ---
PRIOR_P_DIS=0.10
PRIOR_STRENGTH=50
DIS_HAIRCUT=0.0
LAMBDA=0.0

# --- Fees : formule supposée coef*p*(1-p)*N. PM: feeCoefficient lu dans l'API (0.095) ---
KS_FEE_COEF=0.07
PM_FEE_COEF=0.095

# --- Endpoints ---
KALSHI_BASE=https://api.elections.kalshi.com/trade-api/v2
PM_GATEWAY_BASE=https://gateway.polymarket.us
PM_EVENT_PATH=/v1/events/slug/{slug}
PM_MARKET_PATH=/v1/markets/slug/{slug}
PM_BOOK_PATH=/v1/markets/{slug}/book
PM_BOOK_IS_UP=true

RETENTION_DAYS=7
RESOLVE_DELAY_S=75
LOG_LEVEL=INFO

# --- API (dashboard local) ---
# Génère une clé : python -c "import secrets; print(secrets.token_urlsafe(32))"
# Sans API_ID + API_KEY (>= 16 caractères) l'API ne démarre pas.
API_ID=
API_KEY=
# PORT est fourni par Railway ; 8080 en local
PORT=8080
API_CORS_ORIGINS=*

# --- Marchés journaliers above/below (Kalshi KX*D <-> Polymarket *-above-day-*) ---
DAILY_ENABLED=false           # désactivé : aucun contrat Polymarket intl ne coïncide avec les journaliers Kalshi
DAILY_SIZE=10
DAILY_POLL_S=20
DAILY_SCAN_INTERVAL_S=600
DAILY_MIN_EDGE_BPS=50
DAILY_NO_ENTRY_LAST_S=600
DAILY_BAND_LO=0.03
DAILY_BAND_HI=0.97
DAILY_CONCURRENCY=6
DAILY_DAYS_AHEAD=3
DAILY_SETTLE_TOL_S=120
DAILY_RESOLVE_DELAY_S=120

# --- Météo : pluie par ville (Kalshi KXRAIN <-> Polymarket INTERNATIONAL, API Gamma + CLOB) ---
WEATHER_ENABLED=true
WEATHER_SIZE=10
WEATHER_POLL_S=30
WEATHER_SCAN_INTERVAL_S=600
WEATHER_MIN_EDGE_BPS=100          # jour en cours
WEATHER_MIN_EDGE_BPS_NEXT=300     # jours suivants (capital bloqué plus longtemps)
WEATHER_DAYS_AHEAD=1
WEATHER_MAX_STALE_S=10
# Villes dont tu acceptes la station comme identique quand une règle ne donne pas de code (ex. MIA,SEA)
WEATHER_TRUSTED_CITIES=auto   # auto = villes à station unique ; all ; liste (MIA,SEA) ; vide = aucune
PM_GAMMA_BASE=https://gamma-api.polymarket.com
PM_CLOB_BASE=https://clob.polymarket.com

# --- Stockage (plafond Postgres Railway ~500 Mo) ---
DB_MAX_MB=500                 # purge anticipée à 70 %, TRUNCATE des cotes/signaux à 90 %
QUOTE_STORE_EVERY_S=10        # cotes brutes échantillonnées
QUOTE_STORE_LADDERS=false     # profondeur détaillée (5 niveaux) : lourd, désactivé
SIGNAL_OBSERVE_EVERY_S=30     # signaux OBSERVE (REJECT_* jamais stockés, seulement comptés)
DAILY_OBSERVE_EVERY_S=120
WEATHER_OBSERVE_EVERY_S=120
QUOTES_RETENTION_HOURS=24
SIGNALS_RETENTION_DAYS=3

# --- Version de Polymarket utilisée par le moteur 15 min ---
PM_FLAVOR=intl                # intl (polymarket.com : Gamma + CLOB) | us (gateway.polymarket.us, plus utilisé par défaut)
PM_INTL_FEE_COEF=0.07         # PLACEHOLDER : frais taker dynamiques de Polymarket intl (formule coef*p*(1-p)*N) -> à vérifier

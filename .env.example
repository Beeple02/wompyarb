DATABASE_URL=postgresql://arb:arb@localhost:5432/arb
ASSETS=btc,eth,sol,xrp

# --- Paper trading ---
PAPER_SIZE=10
MIN_EDGE_BPS=20
POLL_INTERVAL_S=2
MAX_STALE_S=2
MAX_SKEW_S=1.5
NO_ENTRY_FIRST_S=5
NO_ENTRY_LAST_S=60

# --- Risque (voir README) ---
PRIOR_P_DIS=0.10
PRIOR_STRENGTH=50
DIS_HAIRCUT=0.0
LAMBDA=0.0

# --- Fees : A VERIFIER (formule coef*p*(1-p)*N) ---
KS_FEE_COEF=0.07
PM_FEE_COEF=0.07

# --- Endpoints ---
KALSHI_BASE=https://api.elections.kalshi.com/trade-api/v2
PM_GATEWAY_BASE=https://gateway.polymarket.us
PM_EVENT_PATH=/v1/events/slug/{slug}
PM_MARKET_PATH=/v1/markets/slug/{slug}
PM_BOOK_PATH=/v1/markets/{slug}/book
PM_BOOK_IS_UP=true

RETENTION_DAYS=7
RESOLVE_DELAY_S=75
LOG_LEVEL=INFO
